# --- Server ---
PORT=9000
NODE_ENV=development

# --- Database (MySQL) ---
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_DIALECT=

# --- Superadmin (M1 placeholder auth for /admin routes) ---
# TODO: replace with real superadmin login / SSO in M4
SUPERADMIN_API_TOKEN=change-me-superadmin-token

# --- VAHAN / DL gov-API (Protean) ---
VAHANENV=UAT
VAHANURL=https://api.risewithprotean.io/v1
VAHANURLAPI=https://api.risewithprotean.io/v1
VAHANAPIKEY=
VAHANSECRETKEY=
VAHANSSKEY=
VAHAN_UAT_PUBLIC_KEY=
VAHAN_UAT_PRIVATE_KEY=
VAHAN_PROD_PUBLIC_KEY=
VAHAN_PROD_PRIVATE_KEY=

# --- SurePass (RC + DL, alternative provider to Protean VAHAN) ---
# PROD uses SUREPASS_PROD_*, anything else uses SUREPASS_* (sandbox).
SUREPASS_ENV=UAT
SUREPASS_BASE_URL=
SUREPASS_TOKEN=
SUREPASS_PROD_BASE_URL=
SUREPASS_PROD_TOKEN=
SUREPASS_TIMEOUT_MS=20000
